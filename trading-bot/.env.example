# Sunucu
PORT=3001

# TradingView alert'lerinin gonderdigi JSON icinde ayni deger olmali.
# Alert mesajini kimsenin taklit edememesi icin uzun/rastgele bir deger sec.
WEBHOOK_SECRET=degistir-bunu-uzun-rastgele-bir-anahtarla

# Binance Testnet API bilgileri (https://testnet.binance.vision hesabindan alinir)
# GERCEK Binance hesap key'i DEGIL - testnet icin ayri kayit gerekir.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://testnet.binance.vision

# Islem yapilmasina izin verilen sembol listesi (virgulle ayir)
ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT

# Sadece izlemek (sinyal gormek, /signals ve dashboard'da) icin - islem acmaz.
# Varsayilan 21 coin gelir, degistirebilirsin.
WATCHLIST_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,DOTUSDT,LINKUSDT,LTCUSDT,TRXUSDT,ATOMUSDT,UNIUSDT,ETCUSDT,FILUSDT,APTUSDT,ARBUSDT,OPUSDT,NEARUSDT,LDOUSDT

# Her islemde bakiyenin yuzde kaci kullanilsin (2 = %2)
POSITION_SIZE_PERCENT=2

# Alert'te gelen stop-loss yuzdesi bu degeri asarsa reddedilir (guvenlik siniri)
MAX_STOP_LOSS_PERCENT=10

# --- Strateji Motoru (TradingView'e gerek kalmadan otomatik islem) ---
STRATEGY_ENABLED=true
# "confluence": EMA+SMA+RSI+MACD+Bollinger+ADX+PSAR+Supertrend+Ichimoku+VWAP+
#   Fibonacci+FVG'nin agirlikli oyuyla karar verir (varsayilan, onerilir)
# "ema": sadece basit EMA kesisimine bakar
STRATEGY_MODE=confluence
# Mum grafigi zaman dilimi: 1m, 5m, 15m, 1h, 4h, 1d ...
STRATEGY_CANDLE_INTERVAL=15m
# Kac saniyede bir fiyat kontrol edilsin
STRATEGY_POLL_SECONDS=60
# confluence modunda geriye kac mum cekilsin (Ichimoku 52 mum istiyor, guvenli tampon icin >=100 onerilir)
STRATEGY_CANDLE_LOOKBACK=100
# confluence skoru bu degeri gecerse BUY, bu degerin altina inerse SELL (-1..1 arasi)
STRATEGY_BUY_THRESHOLD=0.4
STRATEGY_SELL_THRESHOLD=-0.4
# ema modunda kullanilan hizli/yavas EMA periyotlari (hizli < yavas olmali)
STRATEGY_EMA_FAST=9
STRATEGY_EMA_SLOW=21
# Strateji BUY actiginda konulacak stop-loss yuzdesi
STRATEGY_STOP_LOSS_PERCENT=2
# Fiyat giris fiyatinin bu yuzde ustune cikinca otomatik satar (kar hedefi)
STRATEGY_TAKE_PROFIT_PERCENT=2

# --- Binance FUTURES Modulu (kaldiracli islem, varsayilan KAPALI) ---
# DIKKAT: Bu ayri bir sistem, Spot'tan farkli testnet hesabi/API key gerekir.
# https://testnet.binancefuture.com adresinden GitHub ile giris yapip
# API key olustur. Kaldirac riskini "Canliya gecmeden once" bolumunde oku.
BINANCE_FUTURES_ENABLED=false
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=
BINANCE_FUTURES_BASE_URL=https://testnet.binancefuture.com

# Futures'ta islem yapilacak semboller (Spot listesinden bagimsiz)
FUTURES_ALLOWED_SYMBOLS=BTCUSDT

# Kaldirac (20 = 20x). Yuksek kaldirac = kucuk fiyat hareketinde buyuk kayip/likidasyon riski.
FUTURES_LEVERAGE=20
# ISOLATED: sadece o pozisyonun marjini riske girer (onerilir). CROSSED: tum bakiye riske girer.
FUTURES_MARGIN_TYPE=ISOLATED

# Bakiyenin yuzde kaci MARJIN olarak kullanilsin (notional = marjin * kaldirac)
FUTURES_POSITION_SIZE_PERCENT=2
# Stop-loss yuzdesi - kaldiraca gore likidasyon mesafesinden guvenli olmali
# (bot bunu otomatik kontrol eder, cok yuksekse BUY'u reddeder)
FUTURES_STOP_LOSS_PERCENT=2
FUTURES_TAKE_PROFIT_PERCENT=2

FUTURES_CANDLE_INTERVAL=15m
FUTURES_CANDLE_LOOKBACK=100
FUTURES_BUY_THRESHOLD=0.4
FUTURES_SELL_THRESHOLD=-0.4
FUTURES_POLL_SECONDS=60

# Sabit listenin disinda, 24 saatte en cok hareket eden ve yeterli hacme
# sahip coinleri otomatik bulup gecici olarak trade listesine eklesin mi?
FUTURES_AUTO_DISCOVER_ENABLED=true
# Kac tane "firsat coin" bulunsun (en yuksek mutlak %degisim)
FUTURES_DISCOVER_TOP_N=5
# Minimum 24 saatlik islem hacmi (USDT) - dusuk hacimli riskli coinleri eler
FUTURES_DISCOVER_MIN_QUOTE_VOLUME=5000000
# Firsat coin listesi kac dakikada bir yenilensin
FUTURES_DISCOVER_INTERVAL_MINUTES=30

# Basabas: fiyat lehte bu yuzde kadar hareket edince stop-loss giris fiyatina cekilir
FUTURES_BREAKEVEN_ENABLED=true
FUTURES_BREAKEVEN_TRIGGER_PERCENT=1

# Trailing stop: aktiflesince sabit kar hedefi yerine en iyi fiyatin gerisinden takip eder
FUTURES_TRAILING_ENABLED=true
FUTURES_TRAILING_ACTIVATION_PERCENT=2
FUTURES_TRAILING_DISTANCE_PERCENT=1

# ADX bu esigin altindaysa (yatay/kararsiz piyasa) yeni islem acilmaz
FUTURES_MIN_ADX_FOR_ENTRY=20

# Portfoy risk sinirlari
# Bir gunde toplam zarar bakiyenin bu yuzdesini gecerse, o gun yeni islem acilmaz
FUTURES_DAILY_MAX_LOSS_PERCENT=5
# Ayni anda en fazla kac pozisyon acik olabilir (0 = sinirsiz)
FUTURES_MAX_CONCURRENT_POSITIONS=8

# Bir pozisyon kapandiktan sonra ayni sembole kac dakika tekrar girilmesin
# (dalgali piyasada kapan-ac-kapan-ac dongusunu ve gereksiz islem ucretini
# onlemek icin). 0 = cooldown yok, hemen tekrar girebilir.
FUTURES_REENTRY_COOLDOWN_MINUTES=15

# Coin bazinda farkli kaldirac: "BTCUSDT:10,ETHUSDT:15" gibi (bos birakilan
# semboller FUTURES_LEVERAGE varsayilanini kullanir)
FUTURES_SYMBOL_LEVERAGE_OVERRIDES=

# Onay bekleyen mod: acik olunca bot yeni sinyalde otomatik acmaz, dashboard'da
# onay bekleyen kayit olusturur - sen onaylarsan (kaldirac/pozisyon boyutunu
# degistirerek de) acilir. Onaylanmazsa suresi dolunca otomatik iptal olur.
FUTURES_APPROVAL_MODE_ENABLED=false
FUTURES_APPROVAL_EXPIRY_MINUTES=10

# Kar onayi: acik olunca, pozisyon bu kar yuzdesine ulasinca bot otomatik
# satmaz - dashboard'da "Sat" / "Tutmaya Devam Et" diye onay bekleyen kayit
# olusturur. Ayni pozisyon icin bir daha sorulmaz. Cevaplanmadan suresi
# dolarsa (FUTURES_PROFIT_APPROVAL_EXPIRY_MINUTES), pozisyon normal
# (trailing/stop-loss) yonetimine devam eder, otomatik satilmaz.
FUTURES_PROFIT_APPROVAL_ENABLED=false
FUTURES_PROFIT_APPROVAL_THRESHOLD_PERCENT=5
FUTURES_PROFIT_APPROVAL_EXPIRY_MINUTES=30

# Otomatik kaldirac: sabit deger yerine oynaklik (ATR%) ve sinyal gucune
# gore bot kaldiraci kendisi hesaplar (dusuk oynaklik/guclu sinyalde
# artirir, yuksek oynaklikta dusurur). Her zaman likidasyon-guvenlik
# kuralini gecebilecek sekilde ust sinirlanir.
FUTURES_AUTO_LEVERAGE_ENABLED=true
FUTURES_MIN_AUTO_LEVERAGE=5
FUTURES_MAX_AUTO_LEVERAGE=30
