# Sunucu
PORT=3001

# TradingView alert'lerinin gonderdigi JSON icinde ayni deger olmali.
# Alert mesajini kimsenin taklit edememesi icin uzun/rastgele bir deger sec.
WEBHOOK_SECRET=degistir-bunu-uzun-rastgele-bir-anahtarla

# Binance Testnet API bilgileri (https://testnet.binance.vision hesabindan alinir)
# GERCEK Binance hesap key'i DEGIL - testnet icin ayri kayit gerekir.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://testnet.binance.vision

# Islem yapilmasina izin verilen sembol listesi (virgulle ayir)
ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT

# Her islemde bakiyenin yuzde kaci kullanilsin (2 = %2)
POSITION_SIZE_PERCENT=2

# Alert'te gelen stop-loss yuzdesi bu degeri asarsa reddedilir (guvenlik siniri)
MAX_STOP_LOSS_PERCENT=10

# --- Strateji Motoru (TradingView'e gerek kalmadan otomatik islem) ---
STRATEGY_ENABLED=true
# "confluence": EMA+SMA+RSI+MACD+Bollinger+ADX+PSAR+Supertrend+Ichimoku+VWAP+
#   Fibonacci+FVG'nin agirlikli oyuyla karar verir (varsayilan, onerilir)
# "ema": sadece basit EMA kesisimine bakar
STRATEGY_MODE=confluence
# Mum grafigi zaman dilimi: 1m, 5m, 15m, 1h, 4h, 1d ...
STRATEGY_CANDLE_INTERVAL=15m
# Kac saniyede bir fiyat kontrol edilsin
STRATEGY_POLL_SECONDS=60
# confluence modunda geriye kac mum cekilsin (Ichimoku 52 mum istiyor, guvenli tampon icin >=100 onerilir)
STRATEGY_CANDLE_LOOKBACK=100
# confluence skoru bu degeri gecerse BUY, bu degerin altina inerse SELL (-1..1 arasi)
STRATEGY_BUY_THRESHOLD=0.4
STRATEGY_SELL_THRESHOLD=-0.4
# ema modunda kullanilan hizli/yavas EMA periyotlari (hizli < yavas olmali)
STRATEGY_EMA_FAST=9
STRATEGY_EMA_SLOW=21
# Strateji BUY actiginda konulacak stop-loss yuzdesi
STRATEGY_STOP_LOSS_PERCENT=2
# Fiyat giris fiyatinin bu yuzde ustune cikinca otomatik satar (kar hedefi)
STRATEGY_TAKE_PROFIT_PERCENT=2
